local function createButton(parent, text, position, size)
local b = Instance.new("TextButton")
b.Size = size
b.Position = position
b.Text = text
b.TextColor3 = Color3.new(1, 1, 1)
b.TextSize = 14
b.Font = Enum.Font.GothamMedium
b.BackgroundColor3 = Color3.fromRGB(75, 48, 120)
b.BorderSizePixel = 0
b.Parent = parent
Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
return b
end

local function createBox(parent, placeholder, position)
local box = Instance.new("TextBox")
box.Size = UDim2.new(0, 330, 0, 35)
box.Position = position
box.PlaceholderText = placeholder
box.Text = ""
box.TextColor3 = Color3.new(1, 1, 1)
box.PlaceholderColor3 = Color3.fromRGB(150, 150, 160)
box.BackgroundColor3 = Color3.fromRGB(38, 36, 48)
box.Font = Enum.Font.Gotham
box.TextSize = 14
box.BorderSizePixel = 0
box.Parent = parent
Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
return box
end

local function home()
clearContent()

local welcome = createLabel(
